---
import BaseLayout from "../layouts/BaseLayout.astro";
const allPots = Object.values(import.meta.glob('./posts/*.md', { eager: true }));
const pageTitle = "Mi blog de Astro aprendizaje";
---

<BaseLayout pageTitle={pageTitle}>
  <p>Aquí es donde publicaré sobre mi viaje de aprendizaje Astro.</p>
  <ul>
    { allPots.map((post: any) => <li><a href={ post.url }>{ post.frontmatter.title }</a></li>) }
  </ul>
</BaseLayout>